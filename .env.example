# ==============================================================================
# OMNI VIDEO STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# 1. Google Gemini Web Session Cookies (For autonomous LLM reasoning & prompter)
GEMINI_SECURE_1PSID=your_1psid_cookie_here
GEMINI_SECURE_1PSIDTS=your_1psidts_cookie_here
GEMINI_SECURE_1PSIDCC=your_1psidcc_cookie_here
GEMINI_SECURE_1PSIDRTS=your_1psidrts_cookie_here

# 2. Chrome CDP Endpoint (Optional: for auto-harvesting live Gemini cookies)
CHROME_CDP_URL=http://localhost:9222

# 3. AI Video Platform API Keys (Optional)
KLING_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=
MIDJOURNEY_API_KEY=

# 4. Sound & Music Sourcing (Optional)
FREESOUND_API_KEY=
